-- Config for the stock Lua skynet node used in cluster interop acceptance.
-- Paths are relative to CWD = skyjs/3rd/skynet (the submodule's own build
-- tree); ../../?.lua reaches skyjs via the full service name (loader.lua
-- substitutes '?' with the whole service name, e.g. test/cluster_lua/main).
thread = 4
harbor = 0
logservice = "logger"
bootstrap = "snlua bootstrap"
start = "test/cluster_lua/main"
cpath = "./cservice/?.so"
lua_path = "./lualib/?.lua;./lualib/?/init.lua"
lua_cpath = "./luaclib/?.so"
luaservice = "./?.lua;./service/?.lua;../../?.lua"
cluster = "../../test/cluster_lua/clustername.lua"
